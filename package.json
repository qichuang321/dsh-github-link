{
  "name": "dsh-github-link",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "把当前 DeepSeek 账号关联到 GitHub，并让 Agent 通过 github 工具读取仓库、管理 Issue。 · Link the current DeepSeek account to GitHub and expose repository / issue operations to the DSH agent.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qichuang321/dsh-github-link.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "oauth"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "host/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
